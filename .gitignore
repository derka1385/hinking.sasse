# Rejected first round, superseded by v2/ — kept locally, not worth publishing
logos/
preview.html

# Throwaway render thumbnails used to check the work
v2/.png/

.DS_Store

# Site: full-resolution source photos (2–16 MB each); tools/credits.json says where they come from
site/tools/raw/

# Editor hook cache (the shared .impeccable/config.json stays tracked)
.impeccable/hook.cache.json

__pycache__/

# Recruitment runtime data and credentials must stay outside the public project.
.env
.env.*
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Local code graph and generated caches; keep them available without publishing them.
graphify-out/

# Keep Blender sources, but leave multi-gigabyte scenes and generated renders local.
site/blender/**
!site/blender/**/
!site/blender/**/*.py
!site/blender/**/*.mjs
!site/blender/**/README.md

# Never publish local recruitment credentials if copied into the checkout.
admin-password.txt
